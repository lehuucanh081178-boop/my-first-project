# ===== SQL SERVER =====
DB_HOST=localhost
DB_PORT=1433
DB_NAME=TarotLoveDB
DB_USER=tarotlove_user
DB_PASS=your_db_password
# DB_INSTANCE=SQLEXPRESS  # Bo comment neu dung named instance

# ===== JWT (thay bang chuoi ngau nhien manh, it nhat 32 ky tu) =====
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING_32_CHARS_MIN

# ===== EMAIL (Gmail App Password) =====
# Tao App Password tai: myaccount.google.com/apppasswords
EMAIL_USER=your@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# ===== MOMO =====
# Sandbox (chi de test local):
# MOMO_PARTNER_CODE=MOMO
# MOMO_ACCESS_KEY=F8BBA842ECF85
# MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
# Production (dang ky tai business.momo.vn):
MOMO_PARTNER_CODE=your_partner_code
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key

# ===== NGAN HANG =====
BANK_NAME=Vietcombank
BANK_ACCOUNT=your_account_number
BANK_OWNER=YOUR_ACCOUNT_NAME

# ===== SERVER =====
PORT=3000
NODE_ENV=development
# Production: thay bang domain that co HTTPS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
